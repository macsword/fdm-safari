{
  "manifest_version": 3,
  "name": "FDM for Safari",
  "short_name": "FDM",
  "description": "Sends downloads from Safari to Free Download Manager.",
  "version": "1.0.0",
  "homepage_url": "https://www.freedownloadmanager.org",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FDM for Safari",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "cookies",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"]
}
